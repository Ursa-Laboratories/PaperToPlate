# Backend only. Paste your Ollama key here; never put it in frontend variables.
# Copy this file to .env if needed. Restart ./start.sh after editing .env.
OLLAMA_API_KEY=
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# An interpreter with a compatible installed CubOS package; never a source-path hack.
CUBOS_VALIDATOR_PYTHON=
CUBOS_API_URL=http://localhost:8742
CUBOS_API_TOKEN=
PAPER_TO_PLATE_PORT=8785
# Optional private link displayed only when configured locally.
PAPER_TO_PLATE_MORNING_DOC_URL=
# Optional: supply an existing Valency OAuth access token instead of in-app sign-in.
# Prefer Connect Bond in the app; it keeps refreshed tokens under ignored data/private/.
VALENCY_ACCESS_TOKEN=
